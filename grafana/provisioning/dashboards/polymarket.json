    {
      "id": 68,
      "type": "table",
      "title": "🗺️ Топ категорий по странам (PostgreSQL)",
      "description": "Какие категории рынков нажимают пользователи из каждой страны",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 79 },
      "options": { "sortBy": [{ "displayName": "Кликов", "desc": true }] },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres" },
          "rawSql": "SELECT country, category, COUNT(*) AS clicks FROM click_events WHERE $__timeFilter(clicked_at) GROUP BY country, category ORDER BY clicks DESC LIMIT 50",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 69,
      "type": "table",
      "title": "📊 Топ категорий (все страны)",
      "description": "Самые популярные категории рынков по кликам",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 79 },
      "options": { "sortBy": [{ "displayName": "Кликов", "desc": true }] },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres" },
          "rawSql": "SELECT category, COUNT(*) AS clicks, COUNT(DISTINCT country) AS countries FROM click_events WHERE $__timeFilter(clicked_at) GROUP BY category ORDER BY clicks DESC",
          "format": "table",
          "refId": "A"
        }
      ]
    }
