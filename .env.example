# Скопируй этот файл в .env и заполни своими значениями:
#   cp .env.example .env

# ── Обязательные ──────────────────────────────────────────────────────────────
TELEGRAM_TOKEN=ВАШ_ТОКЕН_ЗДЕСЬ

# ── База данных ────────────────────────────────────────────────────────────────
POSTGRES_USER=whale_user
POSTGRES_PASSWORD=смени_этот_пароль

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=смени_этот_пароль

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=смени_этот_пароль

# ── Фильтрация (опционально, docker-compose использует эти дефолты) ───────────
MIN_WHALE_AMOUNT=1000
MIN_ODDS=1.15

# ── Redirect-трекинг (опционально) ────────────────────────────────────────────
# Публичный URL сервера. Если не задан — бот отправляет прямую ссылку.
# Пример: BOT_BASE_URL=https://mybot.example.com
BOT_BASE_URL=

# ── Mini App (опционально) ────────────────────────────────────────────────────
# URL GitHub Pages с настройками. Пример:
# MINI_APP_URL=https://yourusername.github.io/poly_site
MINI_APP_URL=
