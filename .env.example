# Скопируй этот файл в .env и заполни своими значениями:
#   cp .env.example .env

# Обязательные
TELEGRAM_TOKEN=ВАШ_ТОКЕН_ЗДЕСЬ

# Опциональные (docker-compose использует эти дефолты если не указано)
MIN_WHALE_AMOUNT=1000
NEWBIE_THRESHOLD=5
MIN_ODDS=1.15

# Публичный URL сервера для redirect-трекинга кликов.
# Если не задан, бот просто отправляет прямую ссылку на Polymarket.
# Пример: BOT_BASE_URL=https://mybot.example.com
BOT_BASE_URL=

# URL GitHub Pages сайта с Mini App настройками.
# После деплоя на GitHub Pages укажи сюда ссылку, например:
# MINI_APP_URL=https://yourusername.github.io/poly_site
MINI_APP_URL=
